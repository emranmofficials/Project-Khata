# Android Release Keystore Configuration Example for Project Khata
# Copy this file to key.properties and replace the values with your actual keystore details:
# cp key.properties.example key.properties
# DO NOT COMMIT key.properties OR upload-keystore.jks TO VERSION CONTROL!

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
